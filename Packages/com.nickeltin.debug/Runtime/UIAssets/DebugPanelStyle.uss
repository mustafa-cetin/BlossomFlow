/* Color Variables - Local to this stylesheet */
:root {
    /* Button Colors */
    --button-bg: rgba(59, 59, 59, 0.9);
    --button-bg-hover: rgba(91, 91, 91, 0.9);
    --button-border-top-left: rgba(130, 130, 130, 0.9);
    --button-border-bottom-right: rgba(50, 50, 50, 0.9);
    --button-border-hover: rgb(72, 72, 204);
    --button-border-focus: rgb(213, 213, 78);
    --button-text: #dcdcdc;
    
    /* Repeat Button Colors */
    --repeat-button-bg: rgba(65, 65, 65, 0.9);
    --repeat-button-bg-hover: rgba(95, 95, 95, 0.9);
    --repeat-button-border-top-left: rgba(140, 140, 140, 0.9);
    --repeat-button-border-bottom-right: rgba(55, 55, 55, 0.9);
    --repeat-button-text: #dcdcdc;
    
    /* Group Colors */
    --group-bg: rgba(75, 75, 75, 0.81);
    --group-border-top-left: rgba(125, 125, 125, 0.9);
    --group-border-bottom-right: rgba(50, 50, 50, 0.9);
    --group-text: #dcdcdc;
    --group-checkmark-color: white;
    
    /* Toggle Colors */
    --toggle-bg: rgba(143, 143, 143, 0.82);
    --toggle-bg-hover: rgba(173, 173, 173, 0.92);
    --toggle-border-top-left: rgba(160, 160, 160, 0.9);
    --toggle-border-bottom-right: rgba(110, 110, 110, 0.9);
    --toggle-text: white;
    --toggle-checkmark-bg: rgb(103, 103, 103);
    --toggle-checkmark-tint: #00ff00;
    
    /* Dropdown Colors */
    --dropdown-arrow-tint: #e6ffff;
    --dropdown-bg: #4b4b4b;
    --dropdown-border: rgba(162, 162, 162, 0.9);
    --dropdown-text: white;
    
    /* Tab Colors */
    --tab-bg: rgba(40, 40, 40, 0.8);
    --tab-bg-hover: rgba(117, 117, 117, 0.9);
    --tab-bg-selected: rgb(169, 169, 169);
    --tab-border-top-left: rgba(115, 115, 115, 0.9);
    --tab-border-bottom-right: rgba(45, 45, 45, 0.9);
    --tab-border-selected-top-left: rgba(170, 170, 170, 0.95);
    --tab-border-selected-bottom-right: rgba(130, 130, 130, 0.9);
    --tab-text: #dcdcdc;
    --tab-text-selected: #ffff43;
    
    /* Console Colors */
    --console-bg: rgba(28, 28, 28, 0.95);
    --console-border: rgba(145, 145, 145, 0.9);
    --console-clear-bg: rgba(68, 68, 68, 0.9);
    --console-clear-bg-hover: rgba(169, 169, 169, 0.8);
    --console-clear-text: rgb(232, 232, 232);
}

.debug-panel-vertical, .debug-panel-horizontal{
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
}

.debug-panel-vertical, .debug-panel-horizontal > *{
    flex-shrink: 1;
}

.debug-panel-horizontal {
    flex-direction: row;
}

.debug-panel-vertical {
    flex-direction: column;
}

/*.debug-panel-vertical > *{*/
/*    align-self: flex-start;*/
/*}*/

.debug-panel-group {
    background-color: var(--group-bg);
    opacity: 1;
    border-color: var(--group-border-bottom-right);
    border-left-color: var(--group-border-top-left);
    border-top-color: var(--group-border-top-left);
    border-right-color: var(--group-border-bottom-right);
    border-bottom-color: var(--group-border-bottom-right);
    border-radius: 8px;
    border-width: 4px;
    margin-top: 8px;
    margin: 4px;
    align-self: auto;
}

.debug-panel-group Label {
    color: var(--group-text);
    -unity-text-align: upper-center;
    -unity-font-style: bold;
    font-size: 150%;
}

/* Adding border */
.debug-panel-group-expander .unity-foldout__toggle{
    border-width: 4px;
    border-color: transparent;
    border-radius: 4px;
}

/* Making toggle white and big */
.debug-panel-group-expander .unity-foldout__checkmark {
    width: 52px;
    height: 52px;
    color: var(--group-checkmark-color);
    -unity-background-image-tint-color: var(--group-checkmark-color);
}

/* Adding on focus color change */
.debug-panel-group-expander .unity-foldout__toggle:focus {
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.9);
}

.debug-panel-group-expander:focus .unity-foldout__checkmark {
    -unity-background-image-tint-color: var(--button-border-focus);
}

.debug-panel-group-expander:focus Label {
    color: var(--button-border-focus);
}

.debug-panel-button {
    border-radius: 8px;
    font-size: 200%;
    background-color: var(--button-bg);
    color: var(--button-text);
    border-color: var(--button-border-bottom-right);
    border-left-color: var(--button-border-top-left);
    border-top-color: var(--button-border-top-left);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    
    border-width: 4px;
    border-bottom-width: 6px;
    margin: 4px;
    -unity-text-align: middle-left;
}

.debug-panel-button:hover {
    border-color: var(--button-border-hover);
    background-color: var(--button-bg-hover);
}

.debug-panel-button:focus {
    border-color: var(--button-border-focus);
    /*border-width: 6px;*/
    /*margin: 2px;*/
    background-color: rgba(100, 100, 80, 0.95);
}

.debug-panel-repeat-button {
    padding: 8px 12px;
    background-color: var(--repeat-button-bg);
    color: var(--repeat-button-text);
    border-color: var(--repeat-button-border-bottom-right);
    border-left-color: var(--repeat-button-border-top-left);
    border-top-color: var(--repeat-button-border-top-left);
    border-right-color: var(--repeat-button-border-bottom-right);
    border-bottom-color: var(--repeat-button-border-bottom-right);
    border-radius: 16px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

.debug-panel-repeat-button:hover {
    border-color: var(--button-border-hover);
    background-color: var(--repeat-button-bg-hover);
}

.debug-panel-repeat-button:focus {
    border-color: var(--button-border-focus);
    /*border-width: 6px;*/
    /*margin: 2px;*/
    background-color: rgba(100, 100, 80, 0.95);
}

.debug-panel-toggle {
    border-radius: 8px;
    background-color: var(--toggle-bg);
    align-self: flex-start;
    border-width: 4px;
    border-left-color: var(--toggle-border-top-left);
    border-top-color: var(--toggle-border-top-left);
    border-right-color: var(--toggle-border-bottom-right);
    border-bottom-color: var(--toggle-border-bottom-right);
    margin: 4px;
    padding: 4px;
    padding-right: 8px;
}

.debug-panel-toggle > Label{
    color: var(--toggle-text);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.debug-panel-toggle:hover {
    border-color: var(--button-border-hover);
    background-color: var(--toggle-bg-hover);
}

.debug-panel-toggle:focus {
    border-color: var(--button-border-focus);
    /*border-width: 6px;*/
    /*margin: 2px;*/
    background-color: rgba(180, 180, 150, 0.95);
}

.debug-panel-toggle .unity-toggle__input{
    width: 50px;
    height: 50px;
}

.debug-panel-toggle .unity-toggle__checkmark{
    align-self: stretch;
    height: 100%;
    width: 100%;
    border-width: 4px;
    border-radius: 4px;
    border-color: initial;
    background-color: var(--toggle-checkmark-bg);
    -unity-background-image-tint-color: var(--toggle-checkmark-tint);
}

.debug-panel-dropdown .unity-base-field__input{
    border-radius: 8px;
    font-size: 150%;
    background-color: var(--button-bg);
    color: var(--button-text);
    border-color: var(--button-border-bottom-right);
    border-left-color: var(--button-border-top-left);
    border-top-color: var(--button-border-top-left);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    -unity-font-style: bold;

    border-width: 4px;
    border-bottom-width: 6px;
    margin: 4px;
    -unity-text-align: middle-left;
}

.debug-panel-dropdown:hover .unity-base-field__input {
    border-color: var(--button-border-hover);
    background-color: var(--toggle-bg-hover);
}

.debug-panel-dropdown:active .unity-base-field__input,
.debug-panel-dropdown:focus .unity-base-field__input {
    border-color: var(--button-border-focus);
    /*border-width: 6px;*/
    /*margin: 2px;*/
    background-color: rgba(100, 100, 80, 0.95);
}

.debug-panel-dropdown .unity-base-popup-field__arrow{
    width: 24px;
    height: 20px;
    -unity-background-image-tint-color: var(--dropdown-arrow-tint);
}

#TabsContainer{
    margin-top: 4px;
    margin-left: 16px;
    margin-right: 16px;
    flex-basis: 5%;
    flex-direction: row;
}

.debug-panel-tab {
    flex-grow: 1;
    background-color: var(--tab-bg);
    border-color: var(--tab-border-bottom-right);
    border-left-color: var(--tab-border-top-left);
    border-top-color: var(--tab-border-top-left);
    border-right-color: var(--tab-border-bottom-right);
    font-size: 200%;
    flex-shrink: 1;
    color: var(--tab-text);
    border-width: 6px;
    border-bottom-width: 0;
    border-top-right-radius: 20px;
    border-top-left-radius: 20px;
    
    -unity-font-style: bold;
    margin: 6px 4px -10px;
}

.debug-panel-tab:hover{
    border-color: var(--button-border-hover);
    background-color: var(--tab-bg-hover);
}

.debug-panel-tab:focus {
    border-color: var(--button-border-focus);
    /*border-width: 8px;*/
    /*margin: 4px 2px -8px;*/
    background-color: rgba(120, 120, 100, 0.9);
}

.debug-panel-selected-tab {
    border-color: var(--tab-border-selected-bottom-right);
    border-left-color: var(--tab-border-selected-top-left);
    border-top-color: var(--tab-border-selected-top-left);
    border-right-color: var(--tab-border-selected-bottom-right);
    margin-top: 2px;
    margin-right: 0;
    margin-left: 0;
    background-color: var(--tab-bg-selected);
    color: var(--tab-text-selected);
}

.debug-panel-selected-tab:focus {
    border-color: var(--button-border-focus);
    /*border-width: 8px;*/
    /*margin: 0px -2px -2px -2px;*/
    background-color: rgba(180, 180, 150, 0.95);
}

#ContentContainer {
    flex-basis: 100%;
    font-size: 20px;
}

#ContentContainer > #CONSOLE {
    flex-grow: 1;
}

.debug-panel-console{
    flex-grow: 1;
    border-width: 0;
    margin: 0 4px 10px;
    justify-content: space-between;
    font-size: 22px;
   
}

.debug-panel-console .unity-list-view{
    flex-grow: 1;
}



.debug-panel-console .unity-list-view .unity-list-view__item{
    white-space: normal;
    -unity-text-align: upper-left;
    border-width: 4px;
    border-radius: 8px;
    border-color: transparent;
    margin: 2px;
    padding: 2px;
    background-color: transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-overflow-position: end;
    max-height: 220px; /* Approximate: 10 lines * ~22px per line (adjust based on your font-size) */
}

.debug-panel-console .unity-list-view .unity-list-view__item.unity-button {
    /* Override default button styling for console buttons */
    -unity-text-align: upper-left;
    padding: 4px;
}

.debug-panel-console .unity-list-view .unity-list-view__item:hover{
    border-color: var(--button-border-hover);
    background-color: rgba(91, 91, 91, 0.5);
}

.debug-panel-console .unity-list-view .unity-list-view__item:focus{
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.7);
}

.debug-panel-console #ClearButton {
    border-radius: 8px;
    font-size: 200%;
    background-color: var(--button-bg);
    color: var(--button-text);
    border-color: var(--button-border-bottom-right);
    border-left-color: var(--button-border-top-left);
    border-top-color: var(--button-border-top-left);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    border-width: 4px;
    border-bottom-width: 6px;
    margin: 4px;
    -unity-text-align: middle-left;
}

.debug-panel-console #ClearButton:hover {
    border-color: var(--button-border-hover);
    background-color: var(--button-bg-hover);
}

.debug-panel-console #ClearButton:focus {
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.95);
}



.hidden {
    display: none;
}

.borderless{
    margin: 0;
    padding: 0;
    border-width: 0;
}


/* SCROLL VIEW */
.debug-panel-scroll-view .unity-scroller {
    position: relative;
    width: 40px;
    min-width: 40px;
    max-width: 40px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.debug-panel-scroll-view .unity-scroller__low-button {
    position: absolute;
    top: 2px;
    bottom: auto;
    left: 0;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    background-color: var(--toggle-bg);
    border-color: var(--button-border-bottom-right);
    border-left-color: rgba(180, 180, 180, 0.9);
    border-top-color: rgba(180, 180, 180, 0.9);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    border-width: 4px;
    border-bottom-width: 6px;
    border-radius: 20px 20px 0 0;
    -unity-background-image-tint-color: var(--button-text);
}

.debug-panel-scroll-view .unity-scroller__low-button:hover {
    border-color: var(--button-border-hover);
    background-color: var(--toggle-bg-hover);
}

.debug-panel-scroll-view .unity-scroller__low-button:focus {
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.95);
}

.debug-panel-scroll-view .unity-scroller__high-button {
    position: absolute;
    top: auto;
    bottom: 2px;
    left: 0;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    background-color: var(--toggle-bg);
    border-color: var(--button-border-bottom-right);
    border-left-color: rgba(180, 180, 180, 0.9);
    border-top-color: rgba(180, 180, 180, 0.9);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    border-width: 4px;
    border-top-width: 6px;
    border-radius: 0 0 20px 20px;
    -unity-background-image-tint-color: var(--button-text);
}

.debug-panel-scroll-view .unity-scroller__high-button:hover {
    border-color: var(--button-border-hover);
    background-color: var(--toggle-bg-hover);
}

.debug-panel-scroll-view .unity-scroller__high-button:focus {
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.95);
}

.debug-panel-scroll-view .unity-scroller__slider {
    position: absolute;
    top: 42px;
    bottom: 42px;
    width: 40px;
    min-width: 40px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.debug-panel-scroll-view .unity-base-slider__tracker {
    width: 40px;
    background-color: var(--button-bg);
    border-color: var(--button-border-bottom-right);
    border-left-color: var(--button-border-bottom-right);
    border-top-color: var(--button-border-bottom-right);
    border-right-color: var(--button-border-bottom-right);
    border-bottom-color: var(--button-border-bottom-right);
    border-width: 4px;
    border-radius: 8px;
}

.debug-panel-scroll-view .unity-base-slider__tracker:hover {
    background-color: rgba(70, 70, 70, 0.95);
}

.debug-panel-scroll-view .unity-base-slider__drag-container {
    flex-grow: 1;
    width: 40px;
}

.debug-panel-scroll-view .unity-base-slider__dragger {
    flex-grow: 1;
    width: 40px;
    left: 0;
    background-color: var(--toggle-bg);
    border-color: var(--toggle-border-bottom-right);
    border-left-color: var(--toggle-border-top-left);
    border-top-color: var(--toggle-border-top-left);
    border-right-color: var(--toggle-border-bottom-right);
    border-bottom-color: var(--toggle-border-bottom-right);
    border-width: 3px;
    border-radius: 8px;
}

.debug-panel-scroll-view .unity-base-slider__dragger:hover {
    background-color: var(--toggle-bg-hover);
    border-color: var(--button-border-hover);
}

.debug-panel-scroll-view .unity-scroller__slider:focus .unity-base-slider__dragger {
    border-color: var(--button-border-focus);
    background-color: rgba(100, 100, 80, 0.95);
}

/* DROPDOWN POPUP STYLES */
.unity-base-dropdown .unity-base-dropdown__container-inner{
    background-color: var(--dropdown-bg);
    opacity: 1;
    border-color: var(--dropdown-border);
    border-radius: 8px;
    border-width: 4px;
}

.unity-base-dropdown .unity-base-dropdown__item{
    padding-left: 8px;
    flex-direction: row;
}

.unity-base-dropdown .unity-base-dropdown__item:checked{
    padding-left: 8px;
}

.unity-base-dropdown .unity-base-dropdown__item Label{
    color: var(--dropdown-text);
    font-size: 200%;
    margin-left: 8px;
}

.unity-base-dropdown .unity-base-dropdown__checkmark{
    width: 38px;
    height: 38px;
    min-width: 38px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--toggle-checkmark-tint);
}