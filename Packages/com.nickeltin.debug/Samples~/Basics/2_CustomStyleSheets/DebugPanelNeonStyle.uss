/* Neon Cyberpunk Theme - Custom Debug Panel Style Showcase */
:root {
    /* Button Colors - Cyan/Magenta Neon */
    --button-bg: rgba(10, 10, 25, 0.95);
    --button-bg-hover: rgba(20, 40, 60, 0.95);
    --button-border-top-left: rgba(0, 255, 255, 0.9);
    --button-border-bottom-right: rgba(255, 0, 255, 0.9);
    --button-border-hover: rgb(0, 255, 255);
    --button-border-focus: rgb(255, 255, 0);
    --button-text: rgb(0, 255, 255);
    
    /* Repeat Button Colors */
    --repeat-button-bg: rgba(15, 5, 30, 0.95);
    --repeat-button-bg-hover: rgba(30, 20, 50, 0.95);
    --repeat-button-border-top-left: rgba(0, 255, 255, 0.9);
    --repeat-button-border-bottom-right: rgba(255, 0, 255, 0.9);
    --repeat-button-text: rgb(200, 255, 255);
    
    /* Group Colors */
    --group-bg: rgba(5, 5, 15, 0.85);
    --group-border-top-left: rgba(0, 255, 255, 1);
    --group-border-bottom-right: rgba(255, 0, 255, 1);
    --group-text: rgb(255, 255, 255);
    --group-checkmark-color: rgb(0, 255, 255);
    
    /* Toggle Colors */
    --toggle-bg: rgba(40, 20, 60, 0.9);
    --toggle-bg-hover: rgba(60, 40, 80, 0.95);
    --toggle-border-top-left: rgba(0, 255, 255, 0.9);
    --toggle-border-bottom-right: rgba(255, 0, 255, 0.9);
    --toggle-text: rgb(255, 255, 255);
    --toggle-checkmark-bg: rgb(10, 10, 30);
    --toggle-checkmark-tint: rgb(0, 255, 255);
    
    /* Dropdown Colors */
    --dropdown-arrow-tint: rgb(0, 255, 255);
    --dropdown-bg: rgba(10, 10, 30, 0.95);
    --dropdown-border: rgba(0, 255, 255, 1);
    --dropdown-text: rgb(200, 255, 255);
    
    /* Tab Colors */
    --tab-bg: rgba(10, 10, 20, 0.85);
    --tab-bg-hover: rgba(40, 20, 60, 0.9);
    --tab-bg-selected: rgb(60, 30, 90);
    --tab-border-top-left: rgba(0, 255, 255, 0.9);
    --tab-border-bottom-right: rgba(255, 0, 255, 0.9);
    --tab-border-selected-top-left: rgba(0, 255, 255, 1);
    --tab-border-selected-bottom-right: rgba(255, 0, 255, 1);
    --tab-text: rgb(200, 255, 255);
    --tab-text-selected: rgb(255, 255, 0);
    
    /* Console Colors */
    --console-bg: rgba(5, 5, 15, 0.98);
    --console-border: rgba(0, 255, 255, 1);
    --console-clear-bg: rgba(20, 10, 30, 0.9);
    --console-clear-bg-hover: rgba(60, 30, 90, 0.9);
    --console-clear-text: rgb(255, 0, 255);
}

/* Extra rounded corners for futuristic look */
.debug-panel-button {
    border-radius: 20px;
    border-width: 5px;
    border-bottom-width: 8px;
    margin: 6px;
    padding: 8px 16px;
    font-size: 220%;
    letter-spacing: 2px;
}

.debug-panel-button:hover {
    /* Glow effect on hover */
    border-width: 6px;
    border-bottom-width: 9px;
    margin: 5px;
}

.debug-panel-button:focus {
    background-color: rgba(30, 60, 90, 1);
    border-width: 7px;
    margin: 4px;
}

/* More pronounced group styling */
.debug-panel-group {
    border-radius: 16px;
    border-width: 6px;
    margin: 8px;
    padding: 4px;
}

.debug-panel-group Label {
    font-size: 180%;
    letter-spacing: 3px;
    -unity-font-style: bold-and-italic;
}

/* Larger checkmark for groups */
.debug-panel-group-expander #unity-checkmark {
    width: 60px;
    height: 60px;
}

/* Enhanced toggle styling */
.debug-panel-toggle {
    border-radius: 16px;
    border-width: 5px;
    margin: 6px;
    padding: 8px 12px;
}

.debug-panel-toggle > Label {
    font-size: 28px;
    letter-spacing: 1px;
}

.debug-panel-toggle .unity-toggle__input {
    width: 60px;
    height: 60px;
}

.debug-panel-toggle .unity-toggle__checkmark {
    border-width: 5px;
    border-radius: 8px;
}

.debug-panel-toggle:focus {
    background-color: rgba(60, 90, 120, 1);
}

/* Repeat buttons with extra spacing */
.debug-panel-repeat-button {
    padding: 12px 18px;
    border-radius: 24px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-width: 5px;
    letter-spacing: 1px;
}

/* Dropdown enhanced styling */
.debug-panel-dropdown .unity-base-field__input {
    border-radius: 16px;
    font-size: 170%;
    border-width: 5px;
    border-bottom-width: 8px;
    margin: 6px;
    letter-spacing: 1px;
}

.debug-panel-dropdown .unity-base-popup-field__arrow {
    width: 28px;
    height: 24px;
}

/* Tab styling with more dramatic differences */
.debug-panel-tab {
    font-size: 220%;
    border-width: 7px;
    border-top-right-radius: 28px;
    border-top-left-radius: 28px;
    margin: 8px 6px -12px;
    letter-spacing: 2px;
}

.debug-panel-selected-tab {
    margin-top: 0;
    border-width: 8px;
    padding: 4px 8px;
}

.debug-panel-selected-tab:focus {
    background-color: rgba(80, 50, 120, 1);
}

/* Console with enhanced borders */
.debug-panel-console {
    margin: 0 6px 12px;
    font-size: 24px;
}

.debug-panel-console .unity-list-view .unity-list-view__item {
    border-width: 5px;
    border-radius: 12px;
    margin: 3px;
    padding: 4px;
    max-height: 240px;
}

.debug-panel-console .unity-list-view .unity-list-view__item:hover {
    background-color: rgba(40, 20, 60, 0.6);
}

.debug-panel-console .unity-list-view .unity-list-view__item:focus {
    background-color: rgba(60, 30, 90, 0.8);
}

.debug-panel-console #ClearButton {
    border-radius: 16px;
    font-size: 220%;
    border-width: 5px;
    border-bottom-width: 8px;
    margin: 6px;
    letter-spacing: 2px;
}

/* Scroll view enhancements */
.debug-panel-scroll-view .unity-scroller {
    width: 48px;
    min-width: 48px;
    max-width: 48px;
    margin-right: 6px;
}

.debug-panel-scroll-view .unity-scroller__low-button,
.debug-panel-scroll-view .unity-scroller__high-button {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    max-width: 48px;
    max-height: 48px;
    border-width: 5px;
    border-radius: 24px;
}

.debug-panel-scroll-view .unity-scroller__low-button {
    border-bottom-width: 8px;
    border-radius: 24px 24px 0 0;
}

.debug-panel-scroll-view .unity-scroller__high-button {
    border-top-width: 8px;
    border-radius: 0 0 24px 24px;
}

.debug-panel-scroll-view .unity-base-slider__tracker {
    width: 48px;
    border-width: 5px;
    border-radius: 12px;
}

.debug-panel-scroll-view .unity-base-slider__dragger {
    width: 48px;
    border-width: 4px;
    border-radius: 10px;
}

.debug-panel-scroll-view .unity-scroller__slider:focus .unity-base-slider__dragger {
    background-color: rgba(60, 90, 120, 1);
}

/* Extra spacing for panels */
.debug-panel-vertical, .debug-panel-horizontal {
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-top: 2px;
}

